# Warnings as errors on our own targets only (never on third-party code).
function(sampler_target_warnings target)
    if(MSVC)
        target_compile_options(${target} PRIVATE /W4 /WX)
    endif()
endfunction()

# Optimised even in the Debug preset (debug Tracktion is too slow for audio).
function(sampler_target_optimised target)
    if(MSVC)
        target_compile_options(${target} PRIVATE "$<IF:$<CONFIG:Debug>,/O2,>")
    endif()
endfunction()

# Plain unoptimised debug code for everything else.
function(sampler_target_debuggable target)
    if(MSVC)
        target_compile_options(${target} PRIVATE "$<$<CONFIG:Debug>:/Od>")
    endif()
endfunction()

# Fails the configure if `target` (or anything it links, transitively) is the Tracktion library. Used for the modules
# that must stay Tracktion-free (analysis, render, model): AGENTS.md "Source layout and dependency direction".
function(sampler_assert_no_tracktion target)
    set(pending ${target})
    set(seen "")
    while(pending)
        list(POP_FRONT pending current)
        if(current IN_LIST seen OR NOT TARGET ${current})
            continue()
        endif()
        list(APPEND seen ${current})
        if(current STREQUAL "sampler_tracktion" OR current MATCHES "^tracktion")
            message(FATAL_ERROR "${target} must not link Tracktion, but it reaches ${current}")
        endif()
        get_target_property(type ${current} TYPE)
        set(deps "")
        foreach(property IN ITEMS INTERFACE_LINK_LIBRARIES LINK_LIBRARIES)
            if(type STREQUAL "INTERFACE_LIBRARY" AND property STREQUAL "LINK_LIBRARIES")
                continue()
            endif()
            get_target_property(value ${current} ${property})
            if(value)
                list(APPEND deps ${value})
            endif()
        endforeach()
        foreach(dep IN LISTS deps)
            string(REGEX REPLACE "^\\$<LINK_ONLY:(.*)>$" "\\1" dep "${dep}")
            list(APPEND pending ${dep})
        endforeach()
    endwhile()
endfunction()
